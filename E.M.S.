\begin{tikzpicture}[scale=0.9]
  % Axes
  \draw[thick, ->] (0,0) -- (8,0) node[right] {Quantity of Solar Panels (Q)};
  \draw[thick, ->] (0,0) -- (0,8) node[above] {Price per Solar Panel (P) in Rands};

  % Original Supply Curve (S1)
  \draw[blue, thick] (1,1.5) -- (7,6.5) node[above right] {$S_1$ (Original Supply - No Subsidy)};

  % Original Demand Curve (D)
  \draw[red, thick] (7,1) -- (1,7) node[above left] {$D$ (Demand for Solar Panels)};

  % New Supply Curve after Subsidy (S2) - shifted down vertically
  \draw[blue, dashed, thick] (1,0.5) -- (7,5.5) node[below right] {$S_2$ (Supply with Subsidy)};

  % Original Equilibrium (E1)
  \coordinate (E1) at (4,4);
  \draw[dashed] (E1) -- (4,0) node[below] {$Q_1$};
  \draw[dashed] (E1) -- (0,4) node[left] {$P_1$};
  \fill[black] (E1) circle (2pt);
  \node[above left] at (E1) {$E_1$};

  % New Equilibrium (E2)
  \coordinate (E2) at (4.8,3.6);
  \draw[dashed] (E2) -- (4.8,0) node[below] {$Q_2$};
  \draw[dashed] (E2) -- (0,3.6) node[left] {$P_2$};
  \fill[black] (E2) circle (2pt);
  \node[above right] at (E_2) {$E_2$};

  % Vertical distance representing the subsidy at the new quantity
  \draw[<->] (4.8,3.6) -- (4.8,4.6) node[mid right] {Subsidy per unit};
\end{tikzpicture}
